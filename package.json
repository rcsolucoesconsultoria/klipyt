{
  "name": "pixgo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:pwa": "npm run dev --workspace=apps/pwa",
    "build:api": "npm run build --workspace=apps/api",
    "build:pwa": "npm run build --workspace=apps/pwa",
    "test:api": "npm run test --workspace=apps/api",
    "test:api:e2e": "npm run test:e2e --workspace=apps/api",
    "migration:run": "npm run migration:run --workspace=apps/api",
    "migration:revert": "npm run migration:revert --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}

# App
NODE_ENV=development
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
PORTAL_URL=http://localhost:5174

# Build dos frontends (Coolify / Docker)
# PWA: relativo — nginx do container faz proxy /api → serviço api
VITE_API_URL_PWA=/api/v1
# Portal: URL pública da API (obrigatório em produção)
VITE_API_URL_PORTAL=https://api.klipyt.com/api/v1
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Coolify/Docker interno: DB_SSL=false (Postgres sem TLS na rede Docker)
DB_SSL=false

# Database (local: localhost:5433 | Coolify/Docker: postgres_db:5432)
DATABASE_URL=postgresql://klipyt_admin:klipyt_strong_password@localhost:5433/klipyt_prod
DB_HOST=localhost
DB_PORT=5433
# DB_HOST=postgres_db
# DB_PORT=5432
DB_USER=klipyt_admin
DB_PASS=klipyt_strong_password
DB_NAME=klipyt_prod

# Redis
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# External APIs
RECEITA_FEDERAL_API_KEY=
BUREAU_API_KEY=
GEOCODING_API_KEY=

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Pix — C6 Bank BaaS (ver pix-collection.json)
# Gateway: mock | c6
PIX_GATEWAY=mock

# OAuth / token BaaS C6 (Bearer {{your_access_token}} na collection)
C6_CLIENT_ID=
C6_CLIENT_SECRET=
C6_ACCESS_TOKEN=

# Sandbox: https://baas-api-sandbox.c6bank.info | Produção: https://baas-api.c6bank.info
C6_API_BASE_URL=https://baas-api-sandbox.c6bank.info

# Chave Pix da conta (path em PUT /v2/pix/webhook/{chave})
C6_PIX_KEY=

# URL PÚBLICA do KLIPYT que o C6 vai chamar (cadastro: body webhookUrl)
# Não é URL do C6 — você informa esta URL no endpoint de cadastro de webhook.
PIX_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/pix

# Segredo para validar assinatura dos POST recebidos em /api/v1/webhooks/pix
PIX_WEBHOOK_SECRET=

# Platform defaults
GLOBAL_MARGIN=0.40
FASE_MONETIZACAO_ATIVA=false
